# Host directory holding the media library, bind-mounted read-only into the
# container at /media. Copy this file to .env and adjust per machine.
#
# Raspberry Pi: the NTFS drive is mounted at /srv/mediadrive and holds several
# top-level folders, so point this at the "media" folder specifically rather
# than the drive root.
MEDIA_HOST_DIR=/srv/mediadrive/media
#
# Local dev example:
# MEDIA_HOST_DIR=./media
